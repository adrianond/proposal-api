<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="001-create-usuario" author="migration">
        <createTable tableName="USUARIO">
            <column name="codigo" type="INTEGER">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="nome" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="002-create-login-usuario" author="migration">
        <createTable tableName="LOGIN_USUARIO">
            <column name="usuario" type="INTEGER">
                <constraints primaryKey="true" nullable="false"
                             foreignKeyName="fk_login_usuario"
                             references="USUARIO(codigo)"/>
            </column>
            <column name="senha" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="003-create-status-proposta" author="migration">
        <createTable tableName="STATUS_PROPOSTA">
            <column name="codigo" type="INTEGER">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="descricao" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="004-create-telefone" author="migration">
        <createTable tableName="TELEFONE">
            <column name="id" type="INTEGER" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="ddd" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="numero" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="tipo" type="VARCHAR(20)"/>
        </createTable>
    </changeSet>

    <changeSet id="005-create-endereco" author="migration">
        <createTable tableName="ENDERECO">
            <column name="id" type="INTEGER" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="logradouro" type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>
            <column name="numero" type="INTEGER"/>
            <column name="complemento" type="VARCHAR(100)"/>
            <column name="bairro" type="VARCHAR(100)"/>
            <column name="cidade" type="VARCHAR(100)"/>
            <column name="estado" type="VARCHAR(2)"/>
            <column name="cep" type="VARCHAR(8)"/>
        </createTable>
    </changeSet>

    <changeSet id="006-create-profissao" author="migration">
        <createTable tableName="PROFISSAO">
            <column name="id" type="INTEGER" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="profissao" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="renda" type="DECIMAL(18,2)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="007-create-cliente" author="migration">
        <createTable tableName="CLIENTE">
            <column name="id" type="INTEGER" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="nome" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="nome_mae" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="nome_pai" type="VARCHAR(100)"/>
            <column name="email" type="VARCHAR(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="rg" type="VARCHAR(9)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="cpf" type="VARCHAR(11)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="data_nascimento" type="DATE"/>
            <column name="telefone_id" type="INTEGER">
                <constraints foreignKeyName="fk_cliente_telefone" references="TELEFONE(id)"/>
            </column>
            <column name="endereco_id" type="INTEGER">
                <constraints foreignKeyName="fk_cliente_endereco" references="ENDERECO(id)"/>
            </column>
            <column name="profissao_id" type="INTEGER">
                <constraints foreignKeyName="fk_cliente_profissao" references="PROFISSAO(id)"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="008-create-garantia" author="migration">
        <createTable tableName="GARANTIA">
            <column name="id" type="INTEGER" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="marca" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="modelo" type="VARCHAR(100)"/>
            <column name="ano_modelo" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="ano_fabricacao" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="valor" type="DECIMAL(18,2)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- PROPOSTA_AUTO já inclui USUARIO_ANALISE (do alter_tables.sql original) -->
    <changeSet id="009-create-proposta-auto" author="migration">
        <createTable tableName="PROPOSTA_AUTO">
            <column name="proposta" type="INTEGER" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="status" type="INTEGER">
                <constraints nullable="false"
                             foreignKeyName="fk_proposta_status"
                             references="STATUS_PROPOSTA(codigo)"/>
            </column>
            <column name="produto" type="VARCHAR(255)"/>
            <column name="data_cadastro" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="data_atualizacao" type="TIMESTAMP"/>
            <column name="inicio_analise" type="TIMESTAMP"/>
            <column name="fim_analise" type="TIMESTAMP"/>
            <column name="usuario_cadastro" type="INTEGER">
                <constraints nullable="false"
                             foreignKeyName="fk_proposta_usr_cad"
                             references="USUARIO(codigo)"/>
            </column>
            <column name="usuario_alteracao" type="INTEGER">
                <constraints foreignKeyName="fk_proposta_usr_alt"
                             references="USUARIO(codigo)"/>
            </column>
            <column name="usuario_analise" type="INTEGER">
                <constraints foreignKeyName="fk_proposta_usr_analise"
                             references="USUARIO(codigo)"/>
            </column>
            <column name="valor" type="DECIMAL(18,2)"/>
            <column name="cliente_id" type="INTEGER">
                <constraints nullable="false"
                             foreignKeyName="fk_proposta_cliente"
                             references="CLIENTE(id)"/>
            </column>
            <column name="garantia_id" type="INTEGER">
                <constraints nullable="false"
                             foreignKeyName="fk_proposta_garantia"
                             references="GARANTIA(id)"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
